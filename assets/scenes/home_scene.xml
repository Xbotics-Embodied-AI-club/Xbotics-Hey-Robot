<!--
  XLeRobot home scene.
  Includes the full home scene (house + furniture + robot) plus wand/dock
  on the cart, positioned at the robot's house location (10, 3).
-->
<mujoco model="xlerobot_home_scene">

  <include file="home_environment.xml"/>

  <worldbody>
    <!-- Tabletop camera: views the wand dock from front/above. -->
    <camera name="table_view"
            pos="10.5 2.85 1.0"
            xyaxes="0.6 0.8 0  -0.35 0.26 0.9"
            fovy="75"/>

    <!-- Wand is a top-level free body so MuJoCo can release it from
         dock_weld and attach it to the gripper weld during manipulation. -->
    <body name="wand" pos="10.10 3.0 0.825">
      <freejoint name="wand_free"/>
      <geom name="wand_stick" type="cylinder" size="0.005"
            fromto="0 0 0 0.188 0 0.068"
            rgba="0.82 0.55 0.35 1"
            mass="0.015" condim="4"/>
      <geom name="wand_ball" type="sphere" size="0.022"
            pos="0.21 0 0.076" rgba="1.0 0.3 0.3 1" mass="0.005"/>
      <site name="wand_grasp" pos="0.035 0 0.0127"
            size="0.005" rgba="1 1 0 0.5"/>
    </body>

  </worldbody>

  <equality>
    <weld name="dock_weld"
          body1="wand_dock" body2="wand"
          relpose="0 0 0.105 1 0 0 0"
          active="true"/>
    <weld name="grip_weld"
          body1="Fixed_Jaw_2" body2="wand" active="false"/>
  </equality>

</mujoco>
