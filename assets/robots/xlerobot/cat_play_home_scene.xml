<!--
  XLeRobot cat-play scene with home environment.
  Includes the full home scene (house + furniture + robot) plus wand/dock
  on the cart, positioned at the robot's house location (10, 3).
-->
<mujoco model="xlerobot_cat_play_home">

  <include file="home_scene.xml"/>

  <worldbody>
    <!-- Tabletop camera: views the wand dock from front/above. -->
    <camera name="table_view"
            pos="10.5 2.85 1.0"
            xyaxes="0.6 0.8 0  -0.35 0.26 0.9"
            fovy="75"/>

    <!-- Wand dock sits on the cart's upper platform, inside its front edge. -->
    <body name="wand_dock" pos="10.10 3.0 0.72">
      <geom name="dock_base" type="cylinder" size="0.04 0.015"
            rgba="0.4 0.4 0.5 1" mass="0.1"/>
      <geom name="pillar_1" type="cylinder" size="0.005 0.06"
            pos="0.015 0.015 0.065" rgba="0.35 0.35 0.45 1" mass="0.01"/>
      <geom name="pillar_2" type="cylinder" size="0.005 0.06"
            pos="-0.015 0.015 0.065" rgba="0.35 0.35 0.45 1" mass="0.01"/>
      <geom name="pillar_3" type="cylinder" size="0.005 0.06"
            pos="0.015 -0.015 0.065" rgba="0.35 0.35 0.45 1" mass="0.01"/>
      <geom name="pillar_4" type="cylinder" size="0.005 0.06"
            pos="-0.015 -0.015 0.065" rgba="0.35 0.35 0.45 1" mass="0.01"/>
      <site name="dock_insertion" pos="0 0 0.10"
            size="0.005" rgba="0 1 0 0.5"/>
    </body>

    <!-- Cat wand (free body, initially held in dock by active dock_weld) -->
    <body name="cat_wand" pos="10.10 3.0 0.825">
      <freejoint name="cat_wand_free"/>
      <geom name="wand_stick" type="cylinder" size="0.005 0.10"
            pos="0 0 0.10" rgba="0.82 0.55 0.35 1"
            mass="0.015" condim="4"/>
      <geom name="wand_ball" type="sphere" size="0.022"
            pos="0 0 0.205" rgba="1.0 0.3 0.3 1" mass="0.005"/>
      <site name="wand_grasp" pos="0 0 0.15"
            size="0.005" rgba="1 1 0 0.5"/>
    </body>
  </worldbody>

  <equality>
    <weld name="dock_weld"
          body1="wand_dock" body2="cat_wand" active="true"/>
    <weld name="grip_weld"
          body1="Fixed_Jaw" body2="cat_wand" active="false"/>
  </equality>

</mujoco>
