[run]
data_file = artifacts/test/.coverage
source = hey_robot

[report]
omit =
    src/hey_robot/audio/*
    src/hey_robot/cli/*
    src/hey_robot/monitoring/*
    src/hey_robot/providers/openai_compat_provider.py
    src/hey_robot/channels/feishu/transport.py
    src/hey_robot/foundation/contract/v1/model_service_pb2.py
    src/hey_robot/foundation/contract/v1/model_service_pb2_grpc.py
    src/hey_robot/robocasa_runtime/v1/robocasa_runtime_pb2.py
    src/hey_robot/robocasa_runtime/v1/robocasa_runtime_pb2_grpc.py
    src/hey_robot/robot_runtime/components/*
    src/hey_robot/robot_runtime/lekiwi/*
    src/hey_robot/robot_runtime/so101/*
    src/hey_robot/robot_runtime/xlerobot/hardware/*
    src/hey_robot/robot_runtime/xlerobot/driver.py
    src/hey_robot/robot_runtime/service.py
    src/hey_robot/robot_runtime/mock.py
    src/hey_robot/robot_runtime/simulation/*
    src/hey_robot/human_follow/*
    src/hey_robot/channels/feishu/channel.py
    src/hey_robot/channels/feishu/inbound.py
    src/hey_robot/bus/client.py
    src/hey_robot/foundation/backends/vla/*
    src/hey_robot/foundation/backends/vln/*
    src/hey_robot/vla/*
    src/hey_robot/motion/grasp_point.py
    src/hey_robot/motion/table_plane.py
    src/hey_robot/skill_os/builtins/dock_manipulation.py
    src/hey_robot/skill_os/builtins/tabletop_manipulation.py
    src/hey_robot/robot_runtime/runtime.py
    src/hey_robot/robot_runtime/control_plane.py
    src/hey_robot/robot_runtime/xlerobot/executor.py
    src/hey_robot/skill_os/controller.py
    src/hey_robot/skill_os/event_sink.py
