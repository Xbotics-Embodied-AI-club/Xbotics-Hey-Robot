# Hey Robot environment template

# =============================================================================
# 1. Agent model providers
# =============================================================================
# Model selection should live in deployment YAML. Keep secrets and endpoint
# overrides here only when needed by the selected provider profiles.

# DashScope
DASHSCOPE_MODEL=qwen-vl-plus
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1


# =============================================================================
# 2. Voice channel
# =============================================================================
# Used by `channels.voice`.

ARK_API_KEY=


# =============================================================================
# 3. Feishu channel
# =============================================================================
# The deployment config reads these variables for the built-in Feishu channel.
# Fill them in if you enable `channels.feishu` in deployment YAML.

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=


# =============================================================================
# 4. Docker Compose optional profiles
# =============================================================================
# Core split deployment.
HEY_ROBOT_FRONTEND_PORT=8080
HEY_ROBOT_NATS_PORT=4222
HEY_ROBOT_NATS_MONITOR_PORT=8222
HEY_ROBOT_APP_UID=1000
HEY_ROBOT_APP_GID=1000
HEY_ROBOT_BASE_IMAGE=hey-robot-base:latest
HEY_ROBOT_GATEWAY_IMAGE=hey-robot-gateway:latest
HEY_ROBOT_AGENT_IMAGE=hey-robot-agent:latest
HEY_ROBOT_ROBOT_IMAGE=hey-robot-robot:latest

# A single-GPU machine should run the `vln` and `robocasa` profiles separately.

HEY_ROBOT_POLICY_IMAGE=hey-robot-policy:latest
HEY_ROBOT_VLN_GPU=0

# Required only when starting the `robocasa` profile.
HEY_ROBOT_ROBOCASA_POLICY_GPU=0
HEY_ROBOT_ROBOCASA_POLICY_PORT=9091
HEY_ROBOT_ROBOCASA_POLICY_CONFIG=/app/configs/evaluation/robocasa365.yaml
HEY_ROBOT_ROBOCASA_POLICY_SERVICE_ID=robocasa365
ROBOCASA_EVALUATOR_TOKEN=
ROBOCASA_DATA_TOKEN=
