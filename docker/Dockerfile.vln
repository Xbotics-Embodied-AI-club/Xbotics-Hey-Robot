# VLN capability service image
# InternVLA-N1 System2 requires huggingface-hub < 1.0, which conflicts with
# the main runtime (>= 1.0). Run in a separate container.

ARG CUDA_VERSION=12.6.2
ARG PYTHON_VERSION=3.12
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-runtime-ubuntu24.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH=/app/.venv/bin:${PATH}

WORKDIR /app

# System deps: python3.12, git, and minimal GL libs (InternNav image loading)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3-pip \
        git \
        build-essential \
        libglib2.0-0 \
        libgl1 \
        libsm6 \
        libxext6 \
        libegl1 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3 \
    && rm -rf /var/lib/apt/lists/*

# Install exactly the isolated VLN dependency group from the shared lockfile.
# InternNav is loaded from the pinned repository submodule at runtime so its
# broad optional extras cannot silently alter this environment.
RUN pip install --break-system-packages uv
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-default-groups --group vln --no-install-project

COPY third_party/InternNav /app/third_party/InternNav
COPY src ./src
COPY configs ./configs
RUN uv sync --frozen --no-default-groups --group vln

# ── Runtime ──

# Default entrypoint: start the VLN capability service.
# Override --config at runtime to switch between sim / real / mock configs.
ENTRYPOINT ["python", "-m", "hey_robot.cli.model_service"]
CMD ["--config", "configs/xlerobot.sim.vla_vln.yaml", "--service-id", "vln_nav"]
